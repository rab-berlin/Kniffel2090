;; kniffel.src - Kniffel2090 mit Zufall fuer den echten Microtronic 2090
;; Grundlage: Version 65 (Listing 'Kniffel 65.pdf'), Labels hier in ASCII.
;; Aenderungen gegenueber Version 65 (nur der Zufall, Spielablauf unveraendert):
;;   1. Wuerfel: RND liefert auf dem echten Geraet einen Zaehler (+3 je Befehl, ca. 205 Schritte/s,
;;      waehrend KIN wartet). Bisher entschied nur das unterste Nibble, und der Abstand zwischen zwei
;;      RND war fest: nur 6 verschiedene Wuerfe, die Haelfte davon Kniffel. Jetzt: mittleres und
;;      oberes Zaehler-Nibble (E, F) in den Akku WL, dann 8-Bit-Generator x = 17 x + D aus AUGEN
;;      (oben) und WL (unten), angenommen wird AUGEN 0-5. WL wird erst danach beim Sortieren gebraucht.
;;   2. Sortiere: D, E, F mit drei MOVI loeschen statt MOVI F,F + HXDZ. HXDZ setzt den Zaehler
;;      auf einen festen Wert; nach einem Eintrag oben (1er-6er) stand der naechste Wurf schon fest.
;;   3. AddiereOben direkt bei PlusOben eingebaut (spart einen Schritt).
;; 256 Schritte (00-FF), kein Schritt frei.
;; Uebersetzen: Labels und #define wie im Listing, Immediate-Werte mit #, Kommentare nach ;.

;; Kniffel2090
;; ####### Register use ########
#define AUGEN rD   ; Würfelzahl über RND
#define SEITEBLOCK r0   ; Aktuelle Seite des Kniffelblocks (C-F)
#define W1 r1   ; Würfel 1
#define W2 r2   ; Würfel 2
#define W3 r3   ; Würfel 3
#define W4 r4   ; Würfel 4
#define W5 r5   ; Würfel 5
#define Z1 r6   ; Zähler 1
#define EINGABE r7   ; 
#define Z2 rC   ; Zähler 2 (0 nach Sortierung)
#define WL r8   ; Zu vergleichende Würfel (lower)
#define WH r9   ; Zu vergleichende Würfel (higher)
#define SUMME1 rD   ; Summe Wurf 1er
#define SUMME2 rE   ; Summe Wurf 10er
#define FIGUR1 rA   ; längster Pasch / 3er, 4er
#define FIGUR2 rB   ; FH, klStr, grStr, Kniffel
#define GLEICH1 rF   ; aktueller Pasch
;; #Speicherregister
#define OBEN1 r1   ; Summe Oben 1er
#define OBEN2 r2   ; Summe Oben 10er
#define GESAMT1 r5   ; Summe Gesamt 1er
#define GESAMT2 r6   ; Summe Gesamt 10er
#define GESAMT3 r7   ; Summe Gesamt 100er
#define BLOCK1 r8   ; Kniffelblock 1-4
#define BLOCK2 r9   ; Kniffelblock 5-6,3er,4er
#define BLOCK3 rA   ; Kniffelblock FH,klStr,grStr,Kniffel
#define BLOCK4 rB   ; Kniffelblock Chance
#define HILF rC   ; 
;; ######## Program ########
Init:           MOVI   #F,BLOCK1           
                DOT    BLOCK1              
                MOVI   #F,BLOCK2           
                MOVI   #F,BLOCK3           
                MOVI   #1,BLOCK4           
                MOVI   #C,SEITEBLOCK       ; Aktuelle Blockseite ist C (C-F)
                MAS    SEITEBLOCK          
Beginn:         EXRM                       
                MOVI   #3,Z1               ; 3 Würfe geben
WurfX:          DISP   #6,SEITEBLOCK       ; Anzeige: W1-W5, aktuelle Blockseite
                MOV    W5,AUGEN            
                CALL   Wuerfel             
                MOV    AUGEN,W5            
                MOV    W4,AUGEN            
                CALL   Wuerfel             
                MOV    AUGEN,W4            
                MOV    W3,AUGEN            
                CALL   Wuerfel             
                MOV    AUGEN,W3            
                MOV    W2,AUGEN            
                CALL   Wuerfel             
                MOV    AUGEN,W2            
                MOV    W1,AUGEN            
                CALL   Wuerfel             
                MOV    AUGEN,W1            
                MOVI   #B,Z2               ; Zähler für 5 Durchläufe (B-F)
Sortiere:       MOVI   #0,SUMME1           ; D, E, F nullen ohne HXDZ:
                MOVI   #0,SUMME2           ; HXDZ wuerde den RND-Zaehler auf einen festen Wert setzen
                MOVI   #0,GLEICH1          
                MOVI   #0,FIGUR1           ; getroffene Figuren löschen
                MOVI   #0,FIGUR2           ; getroffene Figuren löschen
                MOV    W1,WL               
                CALL   TauscheNicht        ; ersten W addieren und in WH schieben
                MOV    W2,WL               ; Sortiert Würfel aufsteigend in R4-R0
                CALL   Sort_WH_WL          ; Bubblesort, 5x aufrufen
                BRC    SortW2              
                MOV    WL,W1               ; Letzter Lauf für Ermittlung
                MOV    WH,W2               ; - Paschlänge (max. Anzahl Gleiche)
SortW2:         MOV    W3,WL               ; - Straßenlänge (Längste Sequenz)
                CALL   Sort_WH_WL          ; - aller Augen (Gesamtsumme Wurf)
                BRC    SortW3              
                MOV    WL,W2               ; Einzelaufruf (Pseudo-Sub) für Ermittlung
                MOV    WH,W3               ; - bestimmter Augen (Augensumme 1-6)
SortW3:         MOV    W4,WL               
                CALL   Sort_WH_WL          
                BRC    SortW4              
                MOV    WL,W3               
                MOV    WH,W4               
SortW4:         MOV    W5,WL               
                CALL   Sort_WH_WL          
                BRC    Return_Q            
                MOV    WL,W4               
                MOV    WH,W5               
Return_Q:       CMPI   #0,EINGABE          ; Augensumme 1,2… oder 6 berechnen?
                BRC    PlusOben            ; ja, dann zurückspringen (Pseudo-Sub)
                SUBI   #F,Z2               
                BRC    Sortiere            
                SUBI   #1,Z1               ; einen Wurf abziehen
Auswertung:     CMPI   #3,FIGUR2           ; Straße geworfen?
                BRZ    KlStrasse           
                BRC    GrStrasse           
                MOVI   #0,FIGUR2           ; nein
                GOTO   Pasch_Q             
GrStrasse:      ADDI   #3,FIGUR2           
KlStrasse:      SUBI   #1,FIGUR2           
Figur1Null:     MOVI   #0,FIGUR1           
                GOTO   Auswahl             
Pasch_Q:        SUBI   #2,FIGUR1           
                BRC    Figur1Null          ; Unterlauf, zu wenig gleiche W
                BRZ    Dreier              ; Genau 3 gleiche W
                CMPI   #1,FIGUR1           
                BRZ    Vierer              ; Genau 4 gleiche W
Kniffel:        ADDI   #8,FIGUR2           
Vierer:         MOVI   #8,FIGUR1           
Dreier:         ADDI   #4,FIGUR1           
                CMP    W2,W1               ; FH?
                BRC    Auswahl             
                CMP    W5,W4               
                BRC    Auswahl             
;; CMP W1,W5
;; BRZ Auswahl
FullHouse:      ADDI   #1,FIGUR2           
Auswahl:        KIN    EINGABE             
                CMPI   #0,Z1               ; noch Wurf frei?
                BRZ    BlockOperation      ; nein, dann nur Tasten 8-F möglich
Waehle1_Q:      CMPI   #1,EINGABE          
                BRC    Waehle3_Q           
                BRZ    Waehle1             
                GOTO   WurfX               ; nächster Wurf mit 0
Waehle1:        MOVI   #0,W5               
                GOTO   Auswahl             
Waehle3_Q:      CMPI   #3,EINGABE          
                BRC    Waehle5_Q           
                BRZ    Waehle3             
Waehle2:        MOVI   #0,W4               
                GOTO   Auswahl             
Waehle3:        MOVI   #0,W3               
                GOTO   Auswahl             
Waehle5_Q:      CMPI   #5,EINGABE          
                BRC    BlockOperation      ; Taste 8-F wurde gedrückt
                BRZ    Waehle5             
Waehle4:        MOVI   #0,W2               
                GOTO   Auswahl             
Waehle5:        MOVI   #0,W1               
                GOTO   Auswahl             
BlockOperation: MOV    SEITEBLOCK,Z2       
                CMPI   #B,EINGABE          ; Akt. Blockseite wechseln? (Taste C-F)
                BRC    Karussell           
                SUBI   #7,EINGABE          ; 8,9,A,B → 1,2,3,4
                BRC    Auswahl             ; ungültige Taste gedrückt
                GOTO   EintragBlock        
Karussell:      MOV    EINGABE,SEITEBLOCK  ; schon ersetzen mit neu gewählter Seite
                MAS    SEITEBLOCK          ; sichern in Arbeitsregister
                SUB    Z2,EINGABE          ; Differenz von akt. und neuer Seite
                BRC    Modulo              ; ergibt Anzahl der Drehungen
                BRZ    Auswahl             ; Seite gleich, keine Drehung nötig
                GOTO   Xregister           
Modulo:         ADDI   #4,EINGABE          ; Max. 4 Drehungen
Xregister:      EXRM                       
Drehen:         MOV    BLOCK1,HILF         ; Blockseiten-Ringtausch
                MOV    BLOCK2,BLOCK1       
                MOV    BLOCK3,BLOCK2       
                MOV    BLOCK4,BLOCK3       
                MOV    HILF,BLOCK4         
                SUBI   #1,EINGABE          
                BRZ    DrehenEnde          
                GOTO   Drehen              
DrehenEnde:     DOT    BLOCK1              ; Neue Blockseite auf LEDs anzeigen
                EXRM                       
                GOTO   Auswahl             
EintragBlock:   CMPI   #2,EINGABE          
                BRC    Ersetzen            
                GOTO   Tick                
Ersetzen:       ANDI   #4,EINGABE          ; 1,2,3,4 → 1,2,4,8 (Multiplex)
                ADDI   #4,EINGABE          
Tick:           EXRM                       
                AND    BLOCK1,EINGABE      ; Feld frei?
                BRZ    DrehenEnde          ; nein, nicht mehr frei, dann neu wählen
                SUB    EINGABE,BLOCK1      ; ja, dann LED ausknippsen
                DOT    BLOCK1              ; und Blockseite auf LEDs anzeigen
                EXRM                       
;; 8,9,A,B → 1,2,4,8 durch BlockOperation
Erste:          CMPI   #C,SEITEBLOCK       
                BRC    Zweite              
                SUBI   #4,EINGABE          ; 1,2,4,8 → 1,2,3,4 (Demultiplex)
                BRC    DeMux1              
                BRZ    DeMux2              
                GOTO   Sortiere            ; Augensumme, Rücksprung nach PlusOben
DeMux1:         ADDI   #1,EINGABE          
DeMux2:         ADDI   #3,EINGABE          
                GOTO   Sortiere            ; Augensumme, Rücksprung nach PlusOben
Zweite:         CMPI   #D,SEITEBLOCK       
                BRC    Dritte              
                CMPI   #2,EINGABE          
                BRC    Test3er4er          
                ADDI   #4,EINGABE          ; 1,2 → 5,6
                GOTO   Sortiere            ; Augensumme, Rücksprung nach PlusOben
PlusOben:       EXRL                       ; Augensumme oben addieren (frueher Unterprogramm AddiereOben)
                ADD    SUMME1,OBEN1        
                ADC    OBEN2               
                ADD    SUMME2,OBEN2        
                EXRL                       
                GOTO   PlusUnten           ; und zur Gesamtsumme
Test3er4er:     AND    FIGUR1,EINGABE      ; Figur 3er oder 4er getroffen?
                BRZ    WurfEnde            ; nein, dann streichen
                GOTO   PlusUnten           ; ja, dann gesamte Augen addieren
Dritte:         CMPI   #E,SEITEBLOCK       
                BRC    PlusUnten           ; Chance eintragen
                AND    FIGUR2,EINGABE      ; Figur FH, klStr, grStr, Kniffel getroffen?
                BRZ    WurfEnde            ; nein, dann nur streichen
GibFH:          MOVI   #1,SUMME2           ; ja, dann mind 25 Punkte geben
                MOVI   #9,SUMME1           
                CMPI   #2,EINGABE          
                BRC    GrOder5er           
                BRZ    GibKlStr            
                GOTO   PlusUnten           
GrOder5er:      CMPI   #4,EINGABE          
                BRZ    GibGrStr            
Gib5er:         ADDI   #A,SUMME1           
                ADC    SUMME2              
GibGrStr:       ADDI   #A,SUMME1           
                ADC    SUMME2              
GibKlStr:       ADDI   #5,SUMME1           
                ADC    SUMME2              
PlusUnten:      CALL   AddiereGesamt       
WurfEnde:       CLEAR                      
                EXRL                       
                MAS    SEITEBLOCK          ; aktuelle Blockseite wiederherstellen
                EXRL                       
                EXRM                       ; Block komplett ausgefüllt?
                OR     BLOCK1,Z1           ; (Z1 ist anfänglich 0)
                OR     BLOCK2,Z1           
                OR     BLOCK3,Z1           
                OR     BLOCK4,Z1           
                BRZ    Bonus_Q             ; dann Bonus prüfen
                GOTO   Beginn              
Bonus_Q:        DISP   #3,rD               
                EXRL                       
                ADDI   #1,OBEN1            ; Bonus erzielt?
                ADC    OBEN2               
                SUBI   #4,OBEN2            
                BRC    ZeigeGesamt         ; Unterlauf, zu wenig Punkte für Bonus
                MOVI   #2,SUMME2           
                MOVI   #3,SUMME1           
                CALL   AddiereAugen        
                EXRL                       ; nötig, weil AddiereAugen auch EXRL macht
ZeigeGesamt:    EXRA                       
                HXDZ                       
Endlos:         GOTO   Endlos              ; Neues Spiel mit RESET
;; ####### Subroutines #######
Wuerfel:        CMPI   #0,AUGEN            ; Würfel im Becher?
                BRC    Zurueck             ; nein, dann zurück
                RND                        ; D, E, F = Zaehler (zufaellig ist nur der Zeitpunkt der Taste 0)
                ADD    rE,WL               ; mittleres und oberes Zaehler-Nibble in den Akku WL
                ADD    rF,WL               ; (R8, beim Wuerfeln frei)
Zufall:         ADDI   #D,WL               ; x = 17 x + D (8 Bit, x = AUGEN WL): WL + D mit Uebertrag ...
                ADC    AUGEN               
                ADD    WL,AUGEN            ; ... AUGEN + WL
                CMPI   #5,AUGEN            ; AUGEN 0-5 annehmen, sonst naechster Schritt
                BRC    Zufall              
                ADDI   #1,AUGEN            ; Augen 1-6
Zurueck:        RET                        
Sort_WH_WL:     CMP    WH,WL               
                BRC    EndeOhneCarry       
                CMPI   #F,Z2               ; 5. Durchlauf?
                BRZ    Berechnung          
                GOTO   TauscheNicht        ; Nein, nächster Würfel
Berechnung:     SUB    WL,WH               
                SUBI   #1,WH               
                BRC    Gleich_Plus1        
                BRZ    Strasse_Plus1       
                MOVI   #0,FIGUR2           ; Nichts getroffen
KeinPasch:      MOVI   #0,GLEICH1          
TauscheNicht:   CMPI   #0,EINGABE          
                BRZ    Dazu                
                CMP    WL,EINGABE          
                BRZ    Dazu                
                GOTO   NichtDazu           
Dazu:           ADD    WL,SUMME1           ; Summe bilden
                ADC    SUMME2              
NichtDazu:      MOV    WL,WH               ; garantiert kein Carry
EndeMitCarry:   STC                        
                RET                        
EndeOhneCarry:  RSC                        
                RET                        
Gleich_Plus1:   ADDI   #1,GLEICH1          
                CMP    GLEICH1,FIGUR1      
                BRC    TauscheNicht        
                MOV    GLEICH1,FIGUR1      
                GOTO   TauscheNicht        
Strasse_Plus1:  ADDI   #1,FIGUR2           
                GOTO   KeinPasch           
AddiereGesamt:  EXRL                       
AddiereAugen:   ADD    SUMME1,GESAMT1      
                ADC    GESAMT2             
                ADC    GESAMT3             
                ADD    SUMME2,GESAMT2      
                ADC    GESAMT3             
                EXRL                       
                RET                        
